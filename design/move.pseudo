def use_item(item_name):
    matching_item = next(
        (item for item in inventory if item.lower() == item_name.lower()),
        None,
    )
    if matching_item is None:
         print("You do not have the{item_name}.")
         return

    if matching_item == "Radio":
         print("You used the Radio to call for support.")
    elif matching_item == "Defense Key":
        print("You used the Defense Key to activate the defense system.")
    elif matching_item == "Signal Flare":
        print("You used the Signal Flare to alert your team.")
